# Copia este archivo como .env y rellena SOLO en tu equipo.
# .env está en .gitignore: nunca se sube a GitHub.
# Solo necesitas la clave del proveedor que uses (puedes dejar el resto vacío).
#
# Claude Code no necesita API key si inicias sesión con una cuenta Pro, Max,
# Team, Enterprise o Console desde el navegador.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
